# ===== 应用配置 =====
APP_NAME=信丰脐橙产销数据分析与智能决策平台
DEBUG=true

# ===== 数据库（MySQL）=====
# 格式: mysql+pymysql://用户名:密码@主机:端口/数据库名?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/xinfeng_orange?charset=utf8mb4

# ===== 安全 =====
# 生产环境必须更换为随机长字符串，例如: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== CORS（前端开发服务器地址，逗号分隔）=====
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ===== 机器学习模型存储目录 =====
ML_STORE_DIR=ml_store
